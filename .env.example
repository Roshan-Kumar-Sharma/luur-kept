# The explainer's only external call. Free-tier OpenRouter is enough — the
# model is rephrasing three sentences that the rules engine already decided.
#
# Get a key at https://openrouter.ai/keys. Everything except the explainer's
# prose works without one, including the CLI, the web app, the tests and the
# evals, so leaving this unset is a supported way to run the project.
OPENROUTER_API_KEY=sk-or-v1-...

# Optional. Defaults to openrouter/free, an auto-router across whichever free
# models are currently available — which matters, because individual free
# models rate-limit upstream without warning.
# KEPT_EXPLAINER_MODEL=openrouter/free
