{
  "name": "kept-workspace",
  "version": "0.1.0",
  "description": "Kept — a care decision engine for clothes.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "kept": "pnpm --filter kept kept",
    "dev": "pnpm --filter kept-web dev",
    "build": "pnpm --filter kept-web build",
    "typecheck": "pnpm --filter kept typecheck",
    "test": "pnpm --filter kept test",
    "test:watch": "pnpm --filter kept test:watch",
    "evals": "pnpm --filter kept evals",
    "lint:knowledge": "pnpm --filter kept lint:knowledge",
    "lint:layers": "pnpm --filter kept lint:layers",
    "check": "pnpm --filter kept check && pnpm --filter kept-web build"
  }
}
